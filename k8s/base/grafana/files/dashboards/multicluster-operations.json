      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "gcp-bigquery"
          },
          "editorMode": "code",
          "format": 0,
          "location": "US",
          "project": "${GCP_PROJECT_ID}",
          "rawQuery": true,
          "rawSql": "SELECT\n  TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n  COALESCE(resource.labels.zone, 'global') AS region,\n  COUNT(*) AS requests\nFROM `${GCP_PROJECT_ID}.${BIGQUERY_DATASET}.requests`\nWHERE $__timeFilter(timestamp)\nGROUP BY time, region\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Request volume by serving region",
      "type": "timeseries"
    },

          "editorMode": "code",
          "format": 0,
          "location": "US",
          "project": "${GCP_PROJECT_ID}",
          "rawQuery": true,
          "rawSql": "SELECT\n  TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n  CAST(httpRequest.status AS STRING) AS status,\n  COUNT(*) AS requests\nFROM `${GCP_PROJECT_ID}.${BIGQUERY_DATASET}.requests`\nWHERE $__timeFilter(timestamp)\nGROUP BY time, status\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Traffic by HTTP status",
      "type": "timeseries"
    },

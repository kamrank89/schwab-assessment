      "pluginVersion": "12.2.5",
      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "gcp-bigquery"
          },
          "editorMode": "code",
          "format": 1,
          "location": "US",
          "project": "${GCP_PROJECT_ID}",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(REGEXP_EXTRACT(httpRequest.requestUrl, r'https?://[^/]+([^?]*)'), '/') AS request_path,\n  COUNT(*) AS requests\nFROM `${GCP_PROJECT_ID}.${BIGQUERY_DATASET}.requests`\nWHERE $__timeFilter(timestamp)\n  AND httpRequest.requestUrl IS NOT NULL\nGROUP BY request_path\nORDER BY requests DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top request paths",
      "type": "bargauge"
    },

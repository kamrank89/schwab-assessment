#!/usr/bin/env bash
set -euo pipefail

{
  printf 'COMMAND=%s\n' "${1-}"
  printf 'CORE_ACCOUNT=%s\n' "${CLOUDSDK_CORE_ACCOUNT-}"
  printf 'USE_ADC=%s\n' "${CLOUDSDK_CONTAINER_USE_APPLICATION_DEFAULT_CREDENTIALS-}"
  for argument in "$@"; do
    printf 'ARG=%s\n' "${argument}"
  done
  printf '%s\n' 'END'
} >>"${TEST_LOG_DIR}/gcloud.log"

if [[ "${1-}" == "config" && "${2-}" == "get-value" ]]; then
  if [[ "${3-}" == "${GCLOUD_OVERRIDE_PROPERTY-}" ]]; then
    printf '%s\n' 'configured'
  else
    printf '%s\n' '(unset)'
  fi
  exit 0
fi

if [[ "${1-}" == "auth" && "${2-}" == "list" ]]; then
  printf '%s\n' "${ACTIVE_ACCOUNT}"
  exit 0
fi

if [[ "${1-}" == "container" ]]; then
  printf '%s\n' 'fake-gateway-kubeconfig' >"${KUBECONFIG}"
  exit 0
fi

exit 99

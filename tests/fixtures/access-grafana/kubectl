#!/usr/bin/env bash
set -euo pipefail

{
  printf 'CORE_ACCOUNT=%s\n' "${CLOUDSDK_CORE_ACCOUNT-}"
  printf 'USE_ADC=%s\n' "${CLOUDSDK_CONTAINER_USE_APPLICATION_DEFAULT_CREDENTIALS-}"
  for argument in "$@"; do
    printf 'ARG=%s\n' "${argument}"
  done
  printf '%s\n' 'END'
} >>"${TEST_LOG_DIR}/kubectl.log"

if [[ "${1-}" == "auth" ]]; then
  printf '%s\n' 'yes'
fi

exit 0
